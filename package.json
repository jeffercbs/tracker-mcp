{
  "name": "@jeffercbs/tracker-mcp",
  "version": "0.6.0",
  "description": "MCP server that lets an AI model access issues, projects and notes in my-tracker on behalf of an authenticated user",
  "author": "Jeferson barrero <jebarrero14@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffercbs/tracker-mcp.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "tracker-mcp": "dist/src/index.js",
    "tracker-mcp-init": "dist/scripts/init.js",
    "tracker-mcp-login": "dist/scripts/login.js",
    "tracker-mcp-logout": "dist/scripts/logout.js",
    "tracker-mcp-whoami": "dist/scripts/whoami.js",
    "tracker-mcp-skill": "dist/scripts/install-skill.js",
    "tracker-mcp-skills": "dist/scripts/install-project-skills.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "init": "tsx scripts/init.ts",
    "login": "tsx scripts/login.ts",
    "logout": "tsx scripts/logout.ts",
    "whoami": "tsx scripts/whoami.ts",
    "skill": "tsx scripts/install-skill.ts",
    "prepublishOnly": "npm run build",
    "skills": "tsx scripts/install-project-skills.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
